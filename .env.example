# FlowTracer Configuration
# Copy this to .env and fill in your actual keys

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key-here
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: For service operations (database setup)
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Stripe Price IDs
STRIPE_PRICE_30MIN_MONTHLY=price_your-30min-monthly-id
STRIPE_PRICE_30MIN_QUARTERLY=price_your-30min-quarterly-id
STRIPE_PRICE_60MIN_MONTHLY=price_your-60min-monthly-id
STRIPE_PRICE_60MIN_QUARTERLY=price_your-60min-quarterly-id